# ---------------------------------------------------------------------------
# 构建产物
# ---------------------------------------------------------------------------
/bin/
/dist/

# ---------------------------------------------------------------------------
# 运行时数据：数据库、WAL、主密钥、Agent 发布文件（12.6 / S13）
# ---------------------------------------------------------------------------
/data/
*.db
*.db-wal
*.db-shm
*.key
install.manifest

# ---------------------------------------------------------------------------
# 本地配置：含真实域名、路径与令牌，绝不入库（9.1 / S13）
# ---------------------------------------------------------------------------
master.yaml
agent.yaml
/.dev-agent/
/configs/master.yaml
/configs/agent.yaml

# 外部主题与注入内容（内置主题已编入二进制，见 internal/theme/builtin）
/themes/

# 备份快照
/backups/

# ---------------------------------------------------------------------------
# 编辑器与系统
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.code-workspace

# ---------------------------------------------------------------------------
# 测试与性能产物
# ---------------------------------------------------------------------------
*.out
*.test
*.prof
coverage.html

# ---------------------------------------------------------------------------
# 本机开发产物与临时验证工作目录
#   根目录下的 .exe（xb-probe-master / dbfp 等）是本地构建的产物，与 bin/、dist/ 同类，
#   一律不入库——它们是几十 MB 的二进制，混进仓库只在浪费体积。
# ---------------------------------------------------------------------------
*.exe
__pycache__/
/.shots/

# ---------------------------------------------------------------------------
# .tmpcheck/ 是本机开发时的临时验证目录（变异验证脚本、截图、日志）。
#   一律不入库：其中 admin-cookie.txt / cookie.txt / login.json 里有**真实会话令牌**，
#   截图与日志也只是一次性的现场记录。
# ---------------------------------------------------------------------------
/.tmpcheck/

# ---------------------------------------------------------------------------
# vendor/：**不随仓库提交**
#   `go mod vendor` 会把 modernc.org/libc / modernc.org/sqlite 各架构的生成代码
#   一并落盘，实测约 208 MB（其中 modernc.org 占大头），压缩后仍要几十 MB，
#   每次克隆都付这个体积；而依赖一共只有 32 个模块，走 GOPROXY 几 MB 就取全。
#   所以仓库只提交 go.mod + go.sum，构建与 CI 一律 `go mod download`。
#
#   ⚠️ 本机可以自己执行 `go mod vendor` 以便离线构建（那份 vendor/ 只属于你的机器，
#   会被下面这条规则排除，不会误入库）。但要知道它的副作用：只要 vendor/ 在磁盘上，
#   Go 就自动切到 `-mod=vendor`；此后一旦改了 go.mod 而没重新 vendor，
#   会报 `go: inconsistent vendoring`——那时重新 `go mod vendor` 或直接删掉目录即可。
# ---------------------------------------------------------------------------
/vendor/
